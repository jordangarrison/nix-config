{
  "name": "jordangarrison-pi-extensions",
  "version": "1.3.0",
  "private": true,
  "description": "Reproducible bundle of Pi extensions managed by Nix",
  "files": [
    "node_modules"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@narumitw/pi-usage": "0.51.0",
    "pi-claude-bridge": "0.7.0",
    "pi-mcp-adapter": "2.23.0",
    "pi-foldable-tools": "0.1.0",
    "pi-subagents": "0.47.1",
    "pi-web-access": "0.22.0",
    "xstate": "5.32.5"
  },
  "bundledDependencies": [
    "@modelcontextprotocol/sdk",
    "@narumitw/pi-usage",
    "pi-claude-bridge",
    "pi-mcp-adapter",
    "pi-foldable-tools",
    "pi-subagents",
    "pi-web-access",
    "xstate"
  ],
  "pi": {
    "extensions": [
      "./node_modules/pi-foldable-tools/index.ts",
      "./node_modules/pi-subagents/index.ts",
      "./node_modules/pi-web-access/index.ts",
      "./node_modules/pi-claude-bridge/src/index.ts",
      "./node_modules/pi-mcp-adapter/index.ts",
      "./node_modules/@narumitw/pi-usage/src/index.ts",
      "./node_modules/@joelhooks/pi-until/extensions/pi-until.ts"
    ],
    "skills": [
      "./node_modules/pi-subagents/skills",
      "./node_modules/pi-mcp-adapter/skills"
    ],
    "prompts": [
      "./node_modules/pi-subagents/prompts"
    ]
  }
}
