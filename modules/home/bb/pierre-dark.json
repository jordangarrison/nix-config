      ],
      "settings": {
        "foreground": "#ebbcba"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#ebbcba"
      }
    },
    {
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#31748f"
      }
    },
    {
      "scope": [
        "storage"
      ],
      "settings": {
        "foreground": "#31748f"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#ebbcba"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#9ccfd8"
      }
    },
    {
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#9ccfd8"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#9ccfd8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c4a7e7"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#e0def4"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#908caa"
      }
    },
    {
      "scope": [
        "invalid"
