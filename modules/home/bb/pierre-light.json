{
  "name": "Rosé Pine Dawn",
  "type": "light",
  "colors": {
    "editor.background": "#faf4ed",
    "editor.foreground": "#575279",
    "editorLineNumber.foreground": "#9893a5",
    "editor.selectionBackground": "#dfdad9",
    "editor.lineHighlightBackground": "#fffaf3",
    "diffEditor.insertedTextBackground": "#56949f26",
    "diffEditor.removedTextBackground": "#b4637a26"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#797593",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#ea9d34"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d7827e"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#d7827e"
      }
    },
    {
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#286983"
      }
    },
    {
      "scope": [
        "storage"
      ],
      "settings": {
        "foreground": "#286983"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#d7827e"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#56949f"
      }
    },
    {
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#56949f"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#56949f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#907aa9"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#575279"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#797593"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#b4637a"
      }
    }
